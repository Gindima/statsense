# .env.exemple  ->  copier en .env
#
# StatSense AI — réglages de déploiement
#
# Ces valeurs suffisent pour un `docker compose up` sur une machine de
# travail. Pour une mise en ligne, changer SECRET_KEY et DB_PASSWORD, et
# renseigner ALLOWED_HOSTS.

# --- base de données -------------------------------------------------------
DB_NAME=statsense
DB_USER=statsense
DB_PASSWORD=statsense
# Port publié sur la machine hôte pour inspecter la base. Sans effet sur
# l'application, qui joint la base par le réseau interne.
DB_PORT_HOTE=5433

# --- application -----------------------------------------------------------
PORT=8000
DEBUG=0
SECRET_KEY=changez-cette-valeur
# Séparés par des virgules. Avec DEBUG=0 et une valeur absente ou fausse,
# Django répond 400 à toute requête.
ALLOWED_HOSTS=*
# Requis derrière un nom de domaine, pour l'admin Django. Exemple :
# CSRF_TRUSTED_ORIGINS=https://statsense.exemple.sn
CSRF_TRUSTED_ORIGINS=

# --- modèle de langage -----------------------------------------------------
# Un réglage d'exploitation. Le modèle ne produit qu'un plan de requête, que
# le moteur valide avant de l'exécuter : n'importe quel modèle sachant écrire
# du JSON convient, et aucun ne peut fausser un chiffre.
#
#   qwen2.5:3b-instruct    ~2 Go, processeur, 8 Go de RAM   ~30 s / question
#   qwen2.5:7b-instruct    ~5 Go, processeur lent ou GPU    ~15 s avec GPU
#   qwen2.5:14b-instruct   ~9 Go, GPU 16 Go et plus         ~3 s
OLLAMA_MODEL=qwen2.5:3b-instruct

